{
  "name": "botflow-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server.ts",
    "dev:local-login": "NODE_ENV=development ALLOW_DEV_AUTH_BYPASS=true VITE_ALLOW_DEV_AUTH_BYPASS=true tsx watch server.ts",
    "dev:live-login": "NODE_ENV=development ALLOW_LIVE_SERVICES_IN_DEV=true VITE_ALLOW_LIVE_SERVICES_IN_DEV=true tsx watch server.ts",
    "build": "vite build",
    "backup:encrypted": "./scripts/backup-encrypted.sh",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0 && tsc --noEmit",
    "security:migrate-media": "NODE_ENV=production tsx scripts/migrate-media-storage.ts",
    "test": "vitest run",
    "start": "NODE_ENV=production node --import tsx/esm server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.102.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "lava-top-sdk": "^1.0.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^1.0.0-rc.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "railway": "^3.11.0",
    "supertest": "^7.2.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
