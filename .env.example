# Runtime mode. Production enables fail-fast config checks and admin API auth.
NODE_ENV="development"
PORT="3000"
HOST="127.0.0.1"

# Development is isolated by default. The server ignores production Supabase,
# Telegram, Lava and AI variables unless this explicit emergency switch is set.
ALLOW_LIVE_SERVICES_IN_DEV="false"
ALLOW_NETWORK_BIND="false"
ALLOW_DEV_AUTH_BYPASS="false"
REQUIRE_ADMIN_MFA="true"

# Separate development services. Use a dedicated Supabase project and test bot.
DEV_APP_URL="http://127.0.0.1:3000"
DEV_ADMIN_EMAIL=""
VITE_DEV_ADMIN_EMAIL=""
DEV_SUPABASE_URL="https://your-dev-project.supabase.co"
DEV_SUPABASE_SERVICE_KEY="your-dev-service-role-key"
VITE_DEV_SUPABASE_URL="https://your-dev-project.supabase.co"
VITE_DEV_SUPABASE_ANON_KEY="your-dev-anon-key"
DEV_WEBAPP_SIGNING_SECRET=""
DEV_TELEGRAM_BOT_TOKEN=""
DEV_GEMINI_API_KEY=""
DEV_DEEPSEEK_API_KEY=""
DEV_LAVA_API_KEY=""
DEV_LAVA_WEBHOOK_SECRET=""
DEV_XAI_API_KEY=""
DEV_GROQ_API_KEY=""
DEV_OPENAI_API_KEY=""

# Public app URL used for Telegram WebApp links and webhooks.
# Required in production; use the real HTTPS URL, not localhost.
APP_URL="http://localhost:3000"

# Admin email. Only this Supabase user can access the admin API.
# Required in production. Use the email you registered in Supabase Auth.
ADMIN_EMAIL=""
# Same email for the frontend login form check (optional but recommended).
VITE_ADMIN_EMAIL=""

# Server-side Supabase storage and auth verification.
# Required in production.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# HMAC secret for signed Telegram WebApp action links.
# Required in production. Use a unique random string, at least 32 characters.
WEBAPP_SIGNING_SECRET=""

# Frontend Supabase Auth.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Воронка, которая открывается по адресу без параметров: статичная кнопка
# «Открыть приложение» у BotFather и путь /sitelab. Значение подставляется при
# сборке фронтенда, поэтому в Docker это ещё и build-arg.
VITE_DEFAULT_FUNNEL_ID=""

# ИИ-ассистент воронок (DeepSeek V4 Flash). Обычно ключ вводится в разделе
# «Настройки» админки; эта переменная — запасной путь для автодеплоя.
# Локально: DEV_DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=""

# Optional AI provider key for image/text generation in the editor.
GEMINI_API_KEY=""

# Распознавание голосовых сообщений подписчиков. Провайдеры пробуются в этом
# порядке, достаточно любого одного; без ключей бот честно просит написать текстом.
# Ключ xAI можно ввести и в разделе «Настройки» админки — он перекрывает переменную.
# Локально: DEV_XAI_API_KEY, DEV_GROQ_API_KEY, DEV_OPENAI_API_KEY.
XAI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Optional Lava.top payments.
# In production, configure both values together or leave both empty.
LAVA_API_KEY=""
LAVA_WEBHOOK_SECRET=""

# Optional default bot token. If data/settings.json stores __ENV_TELEGRAM_BOT_TOKEN__,
# the server hydrates it from this variable at runtime.
TELEGRAM_BOT_TOKEN=""
